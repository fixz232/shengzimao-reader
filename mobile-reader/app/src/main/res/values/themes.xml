<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        启动窗口底色用液态玻璃的极光基色，避免冷启动时先闪一帧白/黑再切到极光背景。
        深色由 values-night 的覆盖文件提供。
    -->
    <style name="Theme.ShengZiMao" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FFF3F4FD</item>
    </style>
</resources>
